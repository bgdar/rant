{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "extends": "./tsconfig.json",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "rootDir": "./",
    "ignoreDeprecations": "6.0",
    "strictPropertyInitialization": false,
    "assets": [
      "**/*.json",
      {
        "include": "../views/**/*",
        "outDir": "dist/views",
        "watchAssets": true
      },
      {
        "include": "../public/**/*",
        "outDir": "dist/public",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  }
}
