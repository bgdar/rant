<!-- Memuat Library Resmi Telegram OIDC SDK -->
<script
  async
  src="https://oauth.telegram.org/js/telegram-login.js?5"
  data-client-id="8781419128"
  data-onauth="onTelegramAuth(data)"
  data-request-access="write phone"
></script>

<script>
  function profile(initialData = {}) {
    return {
      user: initialData.user || {},
      supervisor: initialData.supervisor || null,
      sosmed: initialData.sosmed || {},

      dataTelegramPopup: null,
      // --- STATE EDIT PROFILE ---
      editing: { username: false, email: false },
      tempData: { username: '', email: '' },

      // --- STATE SOSMED AUTH ---

      // id sosmed jika ada atau belu
      telegramId: initialData.sosmed.telegramId,
      discordId: initialData.sosmed.discordId,
      whatsappId: initialData.sosmed.whatsappId,

      loading: false,
      loadingTelegramOpenid: false,
      loadingTelegramPopup: false,
      error: null,

      // ---  EDIT PROFILE ---
      startEdit(field) {
        this.editing[field] = true;
        this.tempData[field] = this.user[field] || '';

        this.$nextTick(() => {
          if (this.$refs[field + 'Input']) {
            this.$refs[field + 'Input'].focus();
          }
        });
      },

      saveEdit(field) {
        if (this.tempData[field] && this.tempData[field].trim() !== '') {
          this.user[field] = this.tempData[field];
        }
        this.editing[field] = false;
      },

      cancelEdit(field) {
        this.editing[field] = false;
      },

      // --- TELEGRAM AUTH dengan Open Id ---
      loginWithTelegramOpenId() {
        this.loadingTelegramOpenid = true;

        const clientId = this.sosmed.telegram_client_id;
        const redirectUri = encodeURIComponent(this.sosmed.telegram_redirect);
        // URL Scope digabung dengan spasi ter-encode (%20)
        const scope = encodeURIComponent('openid profile telegram:bot_access');

        // Direct browser redirect ke Telegram OIDC
        window.location.href = `https://oauth.telegram.org/auth?response_type=code&client_id=${clientId}&redirect_uri=${redirectUri}&scope=${scope}`;
      },

      async loginWithTelegramPopup(dataPopup) {
        console.log(
          '>>> [2. ALPINE CONSOLE] Data diterima dari event data-onauth:',
          dataPopup,
        );

        if (!dataPopup) {
          this.error = 'dataPopup dari Telegram tidak ditemukan.';
          this.loadingTelegramPopup = false;
          return;
        }
        if (dataPopup.id_token) {
          await this.sendTokenToBackend(dataPopup.id_token);
        } else if (dataPopup.hash) {
          // Jika backend menerima dataPopup auth biasa
          await this.senddataPopupToBackend(dataPopup);
        } else {
          this.error = 'Format data Telegram tidak dikenali.';
          this.loadingTelegramPopup = false;
        }
      },

      openTelegramPopup() {
        if (!window.Telegram || !window.Telegram.Login) {
          this.error = 'SDK Telegram belum siap. Coba muat ulang halaman.';
          return;
        }

        this.loadingTelegramPopup = true;
        this.error = null;

        // Panggil popup tanpa callback manual (hasilnya akan otomatis dikirim ke data-onauth)
        Telegram.Login.auth({
          client_id: Number(this.sosmed.telegram_client_id),
          scope: ['profile', 'phone', 'write'],
          request_access: 'write',
        });
      },

      // fungsi send token utnuk login telegram popup
      async sendTokenToBackend(idToken) {
        try {
          const response = await fetch('/sosmed/telegram/callback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_token: idToken }),
          });

          if (!response.ok) throw new Error('Backend mengembalikan error');

          const result = await response.json();

          // Set/update state user jika backend mengembalikan data user terbaru
          if (result.user) {
            this.user = result.user;
          }
        } catch (err) {
          this.error = 'Gagal sinkronisasi dengan server.';
          console.error(err);
        } finally {
          this.loadingTelegramPopup = false;
        }
      },
    };
  }
</script>
