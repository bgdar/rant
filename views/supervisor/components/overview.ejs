                </td>
                
                <!-- Kolom Group Name -->
                <td class="p-4 align-top whitespace-nowrap">
                  <div class="text-xs font-semibold text-black-secondary">
                    <i class="fas fa-users-cog text-gray-accent mr-1 text-[11px]"></i> <%= chat.forumName %>
                  </div>
                  <div class="text-[9px] font-mono text-gray-secondary mt-1">
                    JID: <%= chat.chatId %>
                  </div>
                </td>
                
                <!-- Kolom Message & Tanggal Waktu -->
                <td class="p-4 align-top max-w-xs">
