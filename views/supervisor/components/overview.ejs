                    "<%= chat.message %>"
                  </p>
                  <div class="text-[10px] text-gray-secondary">
                    <i class="far fa-clock mr-1"></i> <%= new Date(chat.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %>
                  </div>
                </td>
                
                <!-- Kolom Tombol Action Terarah -->
                <td class="p-4 align-top text-center whitespace-nowrap">
                  <div class="flex items-center justify-center gap-2">
                    <!-- Tombol Menuju Tautan Grup WhatsApp -->
                    <a 
                      href="<%= chat.whatsappLink %>" 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-2 py-1.5 text-xs font-medium rounded text-white-primary bg-[#25D366] hover:bg-[#20ba5a] transition flex items-center gap-1.5 shadow-sm"
                      title="Buka WhatsApp Web / App"
                    >
                      <i class="fab fa-whatsapp text-[12px]"></i> Ke Grup
                    </a>
                    
                    <!-- Tombol Chat Personal Langsung (wa.me) -->
                    <a 
                      href="https://wa.me<%= chat.phoneNumber %>" 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-2 py-1.5 text-xs font-medium rounded border border-white-accent text-black-accent bg-white-secondary hover:border-black-primary hover:text-black-primary transition flex items-center gap-1.5"
                      title="Kirim Pesan Peringatan Pribadi"
                    >
                      <i class="fas fa-paper-plane text-[11px]"></i> Warning
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <!-- State jika data kosong -->
            <tr>
              <td colspan="4" class="p-8 text-center text-sm text-gray-secondary">
                <i class="fas fa-shield-alt text-main-primary text-2xl mb-2 block"></i>
                Belum ada log pelanggaran baru dari Bot WhatsApp.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Info Card / Panel Kontrol Bot WhatsApp (1/3 width) -->
  <div class="bg-white-primary rounded-xl shadow-sm border border-white-accent p-5 space-y-4">
    <h4 class="font-bold text-black-secondary border-b border-white-accent pb-3">
      <i class="fas fa-qrcode text-black-accent mr-2"></i> Kontrol WhatsApp Bot
    </h4>

    <!-- Shortcut Akses Pengaturan WhatsApp -->
    <div class="space-y-2">
      <a
        href="/whatsapp/session"
        class="w-full flex items-center justify-between p-3 rounded-lg border border-white-accent hover:border-main-accent bg-white-secondary hover:bg-white-primary transition group"
      >
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded bg-main-muted text-main-primary flex items-center justify-center">
            <i class="fas fa-sync text-xs"></i>
          </div>
          <span class="text-sm font-medium text-black-accent group-hover:text-black-primary">Scan QR / Cek Sesi</span>
        </div>
        <i class="fas fa-chevron-right text-xs text-gray-secondary"></i>
      </a>

      <a
        href="/whatsapp/anti-spammer"
        class="w-full flex items-center justify-between p-3 rounded-lg border border-white-accent hover:border-black-primary bg-white-secondary hover:bg-white-primary transition group"
      >
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded bg-white-accent text-black-secondary flex items-center justify-center">
            <i class="fas fa-user-slash text-xs"></i>
          </div>
          <span class="text-sm font-medium text-black-accent group-hover:text-black-primary">Auto Kick Pengguna</span>
        </div>
        <i class="fas fa-chevron-right text-xs text-gray-secondary"></i>
      </a>
    </div>

    <!-- Banner Info Mekanisme WhatsApp -->
    <div class="bg-black-secondary text-white-secondary p-4 rounded-lg space-y-2">
      <div class="flex items-center space-x-2 text-[#25D366] text-xs font-bold uppercase tracking-wider">
        <i class="fab fa-whatsapp"></i>
        <span>Kebijakan Admin</span>
      </div>
      <p class="text-xs text-gray-muted leading-relaxed">
        Pastikan nomor bot Anda sudah dijadikan **Admin Grup** agar fungsi penghapusan pesan (`deleteMessage`) dapat berjalan normal.
      </p>
      <a href="/whatsapp/logs" class="inline-block text-[11px] font-bold text-white-primary underline hover:text-[#25D366]">
        Buka Log Sanksi &rarr;
      </a>
    </div>
  </div>
</div>
