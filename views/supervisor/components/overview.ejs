    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-white-secondary border-b border-white-accent text-xs font-semibold text-gray-secondary uppercase">
            <th class="p-4">Pengirim / Nomor</th>
            <th class="p-4">Nama Grup</th>
