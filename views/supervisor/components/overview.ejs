<!-- ------------- Chat Telegram Terindikasi Tidak Pantas ---------------- -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
  <!-- Tabel Chat Telegram Terindikasi (2/3 width) -->
  <div class="lg:col-span-2 bg-white-primary rounded-xl shadow-sm border border-white-accent overflow-hidden">
    <div class="p-5 border-b border-white-accent flex justify-between items-center bg-white-primary">
      <h4 class="font-bold text-black-secondary flex items-center">
        <!-- Ikon Telegram dengan warna biru khas -->
        <i class="fab fa-telegram text-[#24A1DE] text-lg mr-2"></i> Log Chat Telegram Melanggar
      </h4>
      <!-- Status Webhook / Long Polling Telegram -->
      <div class="flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-green-50 text-green-600 border border-green-200">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span> Webhook Aktif
      </div>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-white-secondary border-b border-white-accent text-xs font-semibold text-gray-secondary uppercase">
            <th class="p-4">User / Username</th>
            <th class="p-4">Grup / Channel</th>
            <th class="p-4">Pesan Terdeteksi</th>
            <th class="p-4 text-center">Tindakan</th>
          </tr>
        </thead>
        <tbody class="text-sm divide-y divide-white-accent">
          <% if (typeof telegramChats !== 'undefined' && telegramChats.length > 0) { %>
            <% telegramChats.forEach(function(chat) { %>
              <tr class="hover:bg-white-secondary/50 transition">
                <!-- Kolom User (Nama Lengkap + @Username Telegram) -->
                <td class="p-4 align-top">
                  <div class="font-medium text-black-primary"><%= chat.user %></div>
                  <div class="text-[11px] text-[#24A1DE] font-medium mt-0.5">
                    <%= chat.username ? '@' + chat.username : 'No Username' %>
                  </div>
                  <div class="text-[9px] font-mono text-gray-secondary mt-0.5">
                    ID: <%= chat.userId %>
                  </div>
                </td>
                
                <!-- Kolom Group Name / Supergroup Title -->
                <td class="p-4 align-top whitespace-nowrap">
                  <div class="text-xs font-semibold text-black-secondary">
                    <i class="fas fa-users text-gray-accent mr-1 text-[11px]"></i> <%= chat.forumName %>
                  </div>
                  <div class="text-[10px] text-gray-secondary mt-1">
                    Chat ID: <%= chat.chatId %>
                  </div>
                </td>
                
                <!-- Kolom Message & Tanggal Waktu -->
                <td class="p-4 align-top max-w-xs">
                  <p class="text-black-muted text-xs bg-white-secondary p-2 rounded border border-white-accent italic mb-1.5">
                    "<%= chat.message %>"
                  </p>
                  <div class="text-[10px] text-gray-secondary">
                    <i class="far fa-clock mr-1"></i> <%= new Date(chat.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %>
                  </div>
                </td>
                
                <!-- Kolom Tombol Action Terarah -->
                <td class="p-4 align-top text-center whitespace-nowrap">
                  <div class="flex items-center justify-center gap-2">
                    <!-- Tombol Menuju Tautan Grup/Pesan Telegram -->
                    <!-- chat.telegramLink bisa berupa tautan ke grup atau deep link ke pesan t.me/c/chat_id/message_id -->
                    <a 
                      href="<%= chat.telegramLink %>" 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-2 py-1.5 text-xs font-medium rounded text-white-primary bg-[#24A1DE] hover:bg-[#208bbf] transition flex items-center gap-1.5 shadow-sm"
                      title="Buka Aplikasi Telegram"
                    >
                      <i class="fab fa-telegram-plane text-[12px]"></i> Ke Telegram
                    </a>
                    
                    <a 
                      href="/moderation/telegram/user/<%= chat.userId %>" 
                      class="px-2 py-1.5 text-xs font-medium rounded border border-white-accent text-black-accent bg-white-secondary hover:border-black-primary hover:text-black-primary transition flex items-center gap-1.5"
                      title="Detail Log User"
                    >
                      <i class="fas fa-user-shield text-[11px]"></i> Profil
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <!-- State jika data kosong -->
            <tr>
              <td colspan="4" class="p-8 text-center text-sm text-gray-secondary">
                <i class="fas fa-shield-alt text-main-primary text-2xl mb-2 block"></i>
                Belum ada log pelanggaran baru dari Bot Telegram.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="bg-white-primary rounded-xl shadow-sm border border-white-accent p-5 space-y-4">
    <h4 class="font-bold text-black-secondary border-b border-white-accent pb-3">
      <i class="fas fa-robot text-black-accent mr-2"></i> Kontrol Telegram Bot
    </h4>

    <!-- Shortcut Akses Pengaturan Telegram -->
    <div class="space-y-2">
      <a
        href="/telegram/settings"
        class="w-full flex items-center justify-between p-3 rounded-lg border border-white-accent hover:border-main-accent bg-white-secondary hover:bg-white-primary transition group"
      >
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded bg-main-muted text-main-primary flex items-center justify-center">
            <i class="fas fa-key text-xs"></i>
          </div>
          <span class="text-sm font-medium text-black-accent group-hover:text-black-primary">Pengaturan BotFather Token</span>
        </div>
        <i class="fas fa-chevron-right text-xs text-gray-secondary"></i>
      </a>

      <a
        href="/telegram/restricted-words"
        class="w-full flex items-center justify-between p-3 rounded-lg border border-white-accent hover:border-black-primary bg-white-secondary hover:bg-white-primary transition group"
      >
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded bg-white-accent text-black-secondary flex items-center justify-center">
            <i class="fas fa-spell-check text-xs"></i>
          </div>
          <span class="text-sm font-medium text-black-accent group-hover:text-black-primary">Kamus Kata Terlarang</span>
        </div>
        <i class="fas fa-chevron-right text-xs text-gray-secondary"></i>
      </a>
    </div>

    <!-- Banner Info Mekanisme Telegram -->
    <div class="bg-black-secondary text-white-secondary p-4 rounded-lg space-y-2">
      <div class="flex items-center space-x-2 text-[#24A1DE] text-xs font-bold uppercase tracking-wider">
        <i class="fab fa-telegram"></i>
        <span>Sistem Restriksi</span>
      </div>
      <p class="text-xs text-gray-muted leading-relaxed">
        Pesan melanggar yang tertangkap oleh bot akan otomatis **dihapus langsung** dari grup menggunakan metode API `deleteMessage`.
      </p>
      <a href="/telegram/logs" class="inline-block text-[11px] font-bold text-white-primary underline hover:text-[#24A1DE]">
        Buka Log Penghapusan &rarr;
      </a>
    </div>
  </div>
</div>

<!-- ------------- Chat Telegram Terindikasi Tidak Pantas ---------------- -->

<!-- ------------- Chat WhatApp Terindikasi Tidak Pantas ---------------- -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
  <!-- Tabel Chat WhatsApp Terindikasi (2/3 width) -->
  <div class="lg:col-span-2 bg-white-primary rounded-xl shadow-sm border border-white-accent overflow-hidden">
    <div class="p-5 border-b border-white-accent flex justify-between items-center bg-white-primary">
      <h4 class="font-bold text-black-secondary flex items-center">
